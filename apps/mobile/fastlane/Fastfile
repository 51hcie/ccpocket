default_platform(:ios)

# --------------------------------------------------------------------------
# iOS
# --------------------------------------------------------------------------
platform :ios do
  desc "Upload metadata and screenshots to App Store Connect"
  lane :metadata do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_IDENTIFIER"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_PRIVATE_KEY"],
      is_key_content_base64: false,
    )

    deliver(
      api_key: api_key,
      skip_binary_upload: true,
      skip_screenshots: ENV["SKIP_SCREENSHOTS"] == "true",
      overwrite_screenshots: true,  # Clear existing before upload
      screenshots_path: "./fastlane/screenshots/store",
      force: true,                  # Skip HTML preview
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false,
    )
  end

  desc "Submit an existing App Store build for review"
  lane :submit_review do
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_IDENTIFIER"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_PRIVATE_KEY"],
      is_key_content_base64: false,
    )

    require "spaceship"

    platform = Spaceship::ConnectAPI::Platform::IOS
    app = Spaceship::ConnectAPI::App.find("com.k9i.ccpocket")
    submission = app.get_ready_review_submission(
      platform: platform,
      includes: "items",
    )
    UI.user_error!("No iOS review submission is ready") unless submission

    items = Spaceship::ConnectAPI::ReviewSubmissionItem.all(
      review_submission_id: submission.id,
      includes: "appStoreVersion",
    )
    UI.user_error!("Expected exactly one review item, found #{items.length}") unless items.length == 1

    version = items.first.app_store_version
    UI.user_error!("Review item has no App Store version") unless version
    UI.user_error!("Expected version #{ENV.fetch("IOS_VERSION")}, found #{version.version_string}") unless version.version_string == ENV.fetch("IOS_VERSION")

    build = version.get_build
    UI.user_error!("Review version has no selected build") unless build
    UI.user_error!("Expected build #{ENV.fetch("IOS_BUILD_NUMBER")}, found #{build.version}") unless build.version == ENV.fetch("IOS_BUILD_NUMBER")

    UI.message("Submitting iOS #{version.version_string} (#{build.version}) for review")
    submitted = submission.submit_for_review
    UI.success("Review submission state: #{submitted.state}")
  end
end

# --------------------------------------------------------------------------
# Android
# --------------------------------------------------------------------------
platform :android do
  desc "Upload metadata and screenshots to Google Play"
  lane :metadata do
    version_code = ENV["ANDROID_VERSION_CODE"].to_s.strip

    upload_to_play_store(
      json_key_data: ENV["GCLOUD_SERVICE_ACCOUNT_CREDENTIALS"],
      track: "internal",
      version_code: version_code.empty? ? nil : version_code,
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: ENV["SKIP_UPLOAD_METADATA"] == "true",
      skip_upload_changelogs: true,
      skip_upload_images: ENV["SKIP_UPLOAD_IMAGES"] == "true",
      skip_upload_screenshots: ENV["SKIP_UPLOAD_SCREENSHOTS"] == "true",
    )
  end
end
